{
  "uid": "vcroles-telemetry",
  "title": "VCRoles telemetry pipeline",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "tags": [
    "vcroles",
    "infrastructure"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"alloy|loki|tempo|mimir|grafana|host|containers|postgres|redis\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Stored scrape results for the current target names. Missing telemetry is not a healthy zero; compare production telemetry age below."
    },
    {
      "id": 2,
      "title": "Process resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"alloy|loki|tempo|mimir|grafana\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Collector accepted spans / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Accepted spans"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Collector failed exports / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total{job=\"alloy\"}[$__rate_interval])) or ((0 * sum(rate(otelcol_exporter_sent_spans_total{job=\"alloy\"}[$__rate_interval]))) and on () (max(up{job=\"alloy\"}) == 1))",
          "legendFormat": "Spans"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total{job=\"alloy\"}[$__rate_interval])) or ((0 * sum(rate(otelcol_exporter_sent_metric_points_total{job=\"alloy\"}[$__rate_interval]))) and on () (max(up{job=\"alloy\"}) == 1))",
          "legendFormat": "Metric points"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total{job=\"alloy\"}[$__rate_interval])) or ((0 * sum(rate(otelcol_exporter_sent_log_records_total{job=\"alloy\"}[$__rate_interval]))) and on () (max(up{job=\"alloy\"}) == 1))",
          "legendFormat": "Log records"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Signal-specific reported export failures. Error counters may not exist until the first error: zero is supplied only while that signal has a sent counter and Alloy is being scraped successfully. Missing collector telemetry remains a gap."
    },
    {
      "id": 5,
      "title": "Production spans / second by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(traces_spanmetrics_calls{service_name=\"vcroles\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Production vcroles spans only. Nested workflow spans can describe the same operation, so these counts are not a user-operation failure-rate denominator."
    },
    {
      "id": 6,
      "title": "Validation service-graph requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{client=~\"user|vcroles-validation\",server=~\"vcroles-validation|vcroles-validation-dependency\"}[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Synthetic validation relationships only. Production dependency edges are not currently instrumented; see the coverage note below. These relationships are not a map of the bot\u2019s Discord/database dependencies."
    },
    {
      "id": 7,
      "title": "Collector exported telemetry / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_sent_spans_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Spans"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Metric points"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_exporter_sent_log_records_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Log records"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Successfully exported spans, metric points and log records. Each series has a different signal unit; do not add them as an application workload count."
    },
    {
      "id": 8,
      "title": "Collector export queue utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(otelcol_exporter_queue_size{job=\"alloy\",component_id=\"otelcol.exporter.otlphttp.tempo\",data_type=\"traces\"}) / (sum(otelcol_exporter_queue_capacity{job=\"alloy\",component_id=\"otelcol.exporter.otlphttp.tempo\",data_type=\"traces\"}) > 0)",
          "legendFormat": "tempo \u00b7 traces"
        },
        {
          "refId": "B",
          "expr": "100 * sum(otelcol_exporter_queue_size{job=\"alloy\",component_id=\"otelcol.exporter.otlphttp.mimir\",data_type=\"metrics\"}) / (sum(otelcol_exporter_queue_capacity{job=\"alloy\",component_id=\"otelcol.exporter.otlphttp.mimir\",data_type=\"metrics\"}) > 0)",
          "legendFormat": "mimir \u00b7 metrics"
        },
        {
          "refId": "C",
          "expr": "100 * sum(otelcol_exporter_queue_size{job=\"alloy\",component_id=\"otelcol.exporter.otlphttp.loki\",data_type=\"logs\"}) / (sum(otelcol_exporter_queue_capacity{job=\"alloy\",component_id=\"otelcol.exporter.otlphttp.loki\",data_type=\"logs\"}) > 0)",
          "legendFormat": "loki \u00b7 logs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Only the three configured export paths are shown: traces to Tempo, metrics to Mimir, logs to Loki. Unused signal queues are omitted. Missing queue metrics remain missing."
    },
    {
      "id": 9,
      "title": "Collector receiver failed telemetry / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_failed_spans_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Spans"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_failed_metric_points_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Metric points"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_failed_log_records_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Log records"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Reported receiver outcomes across application and storage receivers. Failure and refusal panels are separate signals and should not be summed as distinct lost records."
    },
    {
      "id": 10,
      "title": "Collector receiver refused telemetry / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_refused_spans_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Spans"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Metric points"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=\"alloy\"}[$__rate_interval]))",
          "legendFormat": "Log records"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Reported receiver outcomes across application and storage receivers. Failure and refusal panels are separate signals and should not be summed as distinct lost records."
    },
    {
      "id": 11,
      "title": "Production bot telemetry age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(timestamp(vcroles_bot_ready{job=\"vcroles\"}))",
          "legendFormat": "Age of latest sample"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Age of the latest production readiness sample, regardless of readiness value. Normal export interval is 15 seconds. If the series disappears beyond the query lookback, this panel also has no data."
    },
    {
      "id": 12,
      "title": "Dependency-map coverage",
      "type": "text",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "options": {
        "mode": "markdown",
        "content": "### Production dependency edges are not yet available\n\nThe bot exports internal workflow spans. Discord and database client/server dependency edges are not currently instrumented.\n\nThe service-graph panel shows **synthetic validation traffic only**. An empty graph does not mean the bot has no external dependencies.\n\nUse production span throughput, exporter queues, scrape health and telemetry age above to assess collection health."
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "description": "Collection health, signal-specific export throughput and failures, bounded queues, production span status, and explicit service-graph coverage. Validation traffic is kept separate from production."
}
