{
  "uid": "vcroles-runtime",
  "title": "VCRoles host and runtime",
  "description": "Host and selected container resource metrics are available without bot changes. Container CPU includes all processes, including Prisma and FFmpeg. 100% container CPU means one logical core; host CPU is normalized to all cores. Python SDK panels require an approved bot rollout.",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "tags": [
    "vcroles",
    "monitoring"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Host CPU utilization",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"host\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "Host CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
