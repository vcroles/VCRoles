        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cortex_ingester_memory_series{job=\"mimir\"}",
          "legendFormat": "Mimir active metric series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
