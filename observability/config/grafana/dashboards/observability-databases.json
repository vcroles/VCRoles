          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Tempo live-store bytes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tempo_live_store_bytes_received_total{job=\"tempo\"}[$__rate_interval])",
          "legendFormat": "Tempo live-store bytes / second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Tempo completion queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tempo_live_store_complete_queue_length{job=\"tempo\"}",
          "legendFormat": "Tempo completion queue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Backend HTTP request p95 (estimate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate({__name__=~\"loki_request_duration_seconds_bucket|cortex_request_duration_seconds_bucket|tempo_request_duration_seconds_bucket\",job=~\"loki|mimir|tempo\",method=~\"GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS\",route!~\"metrics|ready|api_echo\"}[$__rate_interval])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "HTTP ingestion and query requests only; excludes internal gRPC calls, scheduler long polls, scrapes and readiness probes. Histogram estimate; an idle backend has no percentile. Compare with request volume below."
    },
    {
      "id": 12,
      "title": "RustFS requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rustfs_api_requests_total{job=\"vcroles-storage\"}[$__rate_interval]))",
          "legendFormat": "RustFS requests / second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "RustFS HTTP mean latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rustfs_http_server_request_duration_seconds_sum{job=\"vcroles-storage\"}[$__rate_interval])) / (sum(rate(rustfs_http_server_request_duration_seconds_count{job=\"vcroles-storage\"}[$__rate_interval])) > 0)",
          "legendFormat": "Request mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Mean from histogram sum/count. The native histogram starts with a 0\u20135 second bucket, so its apparent 4.75 second p95 cannot resolve normal request latency. No observations means no latency value."
    },
    {
      "id": 14,
      "title": "Object bucket usage (combined)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustfs_bucket_usage_usage_bytes{job=\"vcroles-storage\"}",
          "legendFormat": "Object bucket usage (combined)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Combined usage across the Loki, Tempo and Mimir buckets. Bucket labels are removed before ingestion; this is not per-bucket quota monitoring. Seven-day retention must age in before usage can settle."
    },
    {
      "id": 15,
      "title": "Object bucket quota (combined)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustfs_bucket_usage_quota_bytes{job=\"vcroles-storage\"}",
          "legendFormat": "Object bucket quota (combined)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Sum of the three bucket quotas. A low combined percentage does not rule out an individual bucket reaching its own quota."
    },
    {
      "id": 16,
      "title": "RustFS free cluster capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rustfs_cluster_capacity_free_bytes{job=\"vcroles-storage\"}",
          "legendFormat": "RustFS free cluster capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "title": "Grafana SQLite open connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_sql_open_connections{job=\"grafana\"}",
          "legendFormat": "{{db_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "title": "Grafana SQLite in-use connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_sql_in_use_connections{job=\"grafana\"}",
          "legendFormat": "{{db_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "title": "Tempo scheduler long-poll duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tempo_request_duration_seconds_sum{job=\"tempo\",method=\"gRPC\",route=\"/tempopb.BackendScheduler/Next\"}[$__rate_interval])) / (sum(rate(tempo_request_duration_seconds_count{job=\"tempo\",method=\"gRPC\",route=\"/tempopb.BackendScheduler/Next\"}[$__rate_interval])) > 0)",
          "legendFormat": "Poll mean"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tempo_request_duration_seconds_bucket{job=\"tempo\",method=\"gRPC\",route=\"/tempopb.BackendScheduler/Next\"}[$__rate_interval])))",
          "legendFormat": "Poll p95 estimate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Internal scheduler waits for work. Long calls can be normal idle polling; these are separate from HTTP query latency. The p95 is a histogram estimate."
    },
    {
      "id": 20,
      "title": "Backend HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate({__name__=~\"loki_request_duration_seconds_count|cortex_request_duration_seconds_count|tempo_request_duration_seconds_count\",job=~\"loki|mimir|tempo\",method=~\"GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS\",route!~\"metrics|ready|api_echo\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Same HTTP routes and rate window as the HTTP p95 panel. Zero requests means no percentile observations."
    },
    {
      "id": 21,
      "title": "Object store quota used (combined)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 80
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rustfs_bucket_usage_usage_bytes{job=\"vcroles-storage\"}) / (sum(rustfs_bucket_usage_quota_bytes{job=\"vcroles-storage\"}) > 0)",
          "legendFormat": "Combined buckets"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Combined usage / combined quota. Individual bucket limits are enforced separately; combined headroom does not establish per-bucket headroom."
    },
    {
      "id": 22,
      "title": "Object store net growth / day (6h trend)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 80
      },
      "targets": [
        {
          "refId": "A",
          "expr": "86400 * deriv(rustfs_bucket_usage_usage_bytes{job=\"vcroles-storage\"}[6h])",
          "legendFormat": "Bytes per day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Daily equivalent of the six-hour linear usage trend, not a measured ingestion rate or a capacity forecast. Retention and compaction can make it negative. Startup windows contain less than six hours of history."
    }
  ]
}
