        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "loki_ingester_memory_chunks{job=\"loki\"}",
          "legendFormat": "Loki buffered chunks"
        }
      ],
      "fieldConfig": {
