      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate({__name__=~\"loki_request_duration_seconds_bucket|cortex_request_duration_seconds_bucket|tempo_request_duration_seconds_bucket\"}[$__rate_interval])))",
