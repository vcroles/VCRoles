    {
      "id": 19,
      "title": "Command callback p95 (estimate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(vcroles_operation_duration_bucket{job=\"$service\",component=\"command\"}[$__rate_interval])))",
