      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, component, operation) (rate(vcroles_operation_duration_bucket{job=\"$service\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{component}}.{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
