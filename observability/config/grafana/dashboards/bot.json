          "sort": "desc"
        }
      },
      "description": "Callback completion duration, not acknowledgement time. TTS callbacks may include playback. Compare the callback observations below; sparse windows do not establish a reliable population percentile."
    },
    {
      "id": 20,
      "title": "TTS phase p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
