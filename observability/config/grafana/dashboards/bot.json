        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Shows the newest selected process at each point in time. Samples older than 60 seconds are omitted; a gap is unknown telemetry, not a healthy zero."
