          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "Member-edit queue depth (sampled)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_member_edit_queued{job=\"$service\"}",
          "legendFormat": "Queued entries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Instantaneous queue entries sampled every five seconds. Dispatch also runs every five seconds; timing drift can create a slow sawtooth even while every batch drains normally. This is not an interval maximum. Use queue-wait/completion latency to assess delay."
    },
    {
      "id": 14,
      "title": "Active member-edit batches (sampled)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_member_edit_inflight{job=\"$service\"}",
          "legendFormat": "Active batches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Instantaneous active batches, including work waiting for a member lock or Discord. Short-lived batches may fall between samples; periodic spikes can be a sampling effect rather than periodic dispatch."
    },
    {
