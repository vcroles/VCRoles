        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 88
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vcroles_member_edit_queue_wait_sum{job=\"$service\"}[$__rate_interval])) / (sum(rate(vcroles_member_edit_queue_wait_count{job=\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "Queue wait mean"
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(vcroles_member_edit_queue_completion_sum{job=\"$service\"}[$__rate_interval])) / (sum by (outcome) (rate(vcroles_member_edit_queue_completion_count{job=\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "Completion mean \u00b7 {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Per-entry means, including coalesced entries. Queue wait ends when a batch starts; completion includes queue wait, lock wait and Discord work. Empty windows have no mean."
    }
  ]
}
