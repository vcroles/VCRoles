{
  "uid": "vcroles-bot-health",
  "title": "VCRoles bot health",
  "description": "Gateway, runtime, logical database, command, queued member-edit, generator, and TTS instrumentation. No data is expected before SDK activation; choose vcroles-sdk-validation for synthetic probes. Health gauges select the newest process with samples younger than 60 seconds. Permission retry panels distinguish checks, queued updates and recovery decisions.",
  "schemaVersion": 40,
  "version": 4,
  "editable": false,
  "tags": [
    "vcroles",
    "bot"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "vcroles,vcroles-sdk-validation",
        "current": {
          "text": "vcroles",
          "value": "vcroles"
        },
        "options": [
          {
            "text": "vcroles",
            "value": "vcroles",
            "selected": true
          },
          {
            "text": "vcroles-sdk-validation",
            "value": "vcroles-sdk-validation",
            "selected": false
          }
        ]
      },
      {
        "name": "instance",
        "label": "Process instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(vcroles_bot_ready{job=\"$service\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(vcroles_bot_ready{job=\"$service\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "description": "All retains process history. Select a run to investigate a restart; health gauges still reject samples older than 60 seconds."
      }
    ]
  },
  "panels": [
    {
      "id": 24,
      "title": "Latest telemetry age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(timestamp(vcroles_bot_ready{job=\"$service\",instance=~\"$instance\"}))",
          "legendFormat": "Latest sample age",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No telemetry",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "description": "Instant query of the latest selected readiness sample timestamp; normal export interval is 15 seconds. It remains visible while aging until Mimir lookback expires, then shows no data. This measures export freshness, not an independent HTTP health check or event-loop heartbeat."
    },
    {
      "id": 25,
      "title": "Reading health across restarts",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Health gauges** show the newest selected process and omit samples over **60 seconds old**. A gap means **unknown telemetry**. Use **Process instance** to inspect a particular run.\n\n**Rates and percentiles** retain the selected process history over their calculation window. Telemetry age measures export freshness; it is not a direct `/status` probe."
      }
    },
    {
      "id": 1,
      "title": "Bot readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(vcroles_bot_ready{job=\"$service\",instance=~\"$instance\"}) and on (job, instance) (topk by (job) (1, timestamp(vcroles_bot_ready{job=\"$service\",instance=~\"$instance\"}) > time() - 60)) and (time() - timestamp(vcroles_bot_ready{job=\"$service\",instance=~\"$instance\"}) < 60)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          },
          "noValue": "Unknown"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Shows the newest selected process at each point in time. Samples older than 60 seconds are omitted; a gap is unknown telemetry, not a healthy zero."
    },
