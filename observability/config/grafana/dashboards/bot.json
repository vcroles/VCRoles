    },
    {
      "id": 21,
      "title": "Command observations in percentile window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 80
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (increase(vcroles_operation_duration_count{job=\"$service\",component=\"command\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Observation-count estimates over the same adaptive rate window used by the corresponding p95 panel. Increase can be fractional because it extrapolates scrape boundaries; zero means no recorded observations in the window."
    },
    {
      "id": 22,
      "title": "TTS phase observations in percentile window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
