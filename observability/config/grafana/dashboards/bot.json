{
  "uid": "vcroles-bot-health",
  "title": "VCRoles bot health",
  "description": "Optional gateway, runtime, and logical database instrumentation. No data is expected before the SDK is enabled. Select vcroles-sdk-validation to inspect synthetic SDK probes.",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "tags": [
    "vcroles",
    "bot"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "vcroles,vcroles-sdk-validation",
        "current": {
          "text": "vcroles",
          "value": "vcroles"
        },
        "options": [
          {
            "text": "vcroles",
            "value": "vcroles",
            "selected": true
          },
          {
            "text": "vcroles-sdk-validation",
            "value": "vcroles-sdk-validation",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Bot readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_bot_ready{job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Database connection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_database_connected{job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Event-loop delay",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_event_loop_lag{job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Gateway heartbeat latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_gateway_latency{job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Shard events / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event, shard_id) (rate(vcroles_gateway_events{job=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Logical operations / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, operation, outcome) (rate(vcroles_operations{job=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Logical operation p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, component, operation) (rate(vcroles_operation_duration_bucket{job=\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Operation errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, operation) (rate(vcroles_operations{job=\"$service\",outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "SDK queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"otel_sdk_processor_(span|log)_queue_size\",job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "SDK dropped telemetry / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (otel_component_type, error_type) (rate({__name__=~\"otel_sdk_processor_(span|log)_processed\",job=\"$service\",error_type!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Peak process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_process_peak_rss{job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Async tasks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vcroles_runtime_tasks{job=\"$service\"}",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{shard_id}} {{otel_component_type}} {{error_type}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
