      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (otel_component_type) (rate({__name__=~\"otel_sdk_processor_(span|log)_processed\",job=\"$service\",instance=~\"$instance\",error_type!=\"\"}[$__rate_interval])) or on (otel_component_type) (0 * max by (otel_component_type) (({__name__=~\"otel_sdk_processor_(span|log)_queue_size\",job=\"$service\",instance=~\"$instance\"}) and on (job, instance) (topk by (job) (1, timestamp(vcroles_bot_ready{job=\"$service\",instance=~\"$instance\"}) > time() - 60)) and (time() - timestamp({__name__=~\"otel_sdk_processor_(span|log)_queue_size\",job=\"$service\",instance=~\"$instance\"}) < 60)))",
          "legendFormat": "{{otel_component_type}}"
        }
