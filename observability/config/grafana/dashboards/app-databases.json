        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_connected_clients{job=\"redis\"}",
          "legendFormat": "Redis"
        }
      ],
      "fieldConfig": {
        "defaults": {
