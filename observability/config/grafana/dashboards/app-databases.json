{
  "uid": "vcroles-app-databases",
  "title": "VCRoles application databases",
  "description": "PostgreSQL statistics and Redis server health, without application table contents, key scans, query text, or Redis values. PostgreSQL uses a dedicated monitoring login; Redis uses its configured private authentication.",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "tags": [
    "vcroles",
    "monitoring"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{job=\"postgres\"}",
          "legendFormat": "{{service}} {{datname}} {{mode}} {{job}} {{device}} {{operation}} {{db_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Redis availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up{job=\"redis\"}",
          "legendFormat": "{{service}} {{datname}} {{mode}} {{job}} {{device}} {{operation}} {{db_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
