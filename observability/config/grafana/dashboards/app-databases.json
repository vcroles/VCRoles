    },
    {
      "id": 16,
      "title": "Redis keyspace hit rate (when reads occur)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval]) / ((rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval]) + rate(redis_keyspace_misses_total{job=\"redis\"}[$__rate_interval])) > 0)",
          "legendFormat": "Read hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "No observations",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Hits / (hits + misses), only when the rate window contains keyspace reads. Gaps mean no reads or missing telemetry, not a 0% hit rate. HINCRBY traffic is not a cache lookup; compare the read and command panels below."
    },
    {
      "id": 17,
      "title": "Redis received bytes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
