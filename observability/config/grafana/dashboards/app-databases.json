    {
      "id": 7,
      "title": "PostgreSQL buffer-cache hit rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"postgres\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{job=\"postgres\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "{{service}} {{datname}} {{mode}} {{job}} {{device}} {{operation}} {{db_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
