        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Current Redis connections, including retained idle pool connections and monitoring clients. A pool can grow under concurrency and plateau; this count alone does not establish a leak."
    },
