    {
      "id": 19,
      "title": "Redis keyspace reads / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval])",
          "legendFormat": "Hits"
        },
        {
          "refId": "B",
          "expr": "rate(redis_keyspace_misses_total{job=\"redis\"}[$__rate_interval])",
          "legendFormat": "Misses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Read observations behind the hit-rate panel, using the same rate window. Zero traffic makes the ratio undefined."
    },
    {
      "id": 20,
      "title": "Redis commands / second by command",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 72
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (cmd) (rate(redis_commands_total{job=\"redis\"}[$__rate_interval])))",
          "legendFormat": "{{cmd}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Top eight commands at each time. Includes analytics increments and exporter commands, which need not contribute to keyspace hit/miss counters."
    }
