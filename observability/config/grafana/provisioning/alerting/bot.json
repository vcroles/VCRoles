{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "VCRoles bot",
      "folder": "VCRoles",
      "interval": "60s",
      "rules": [
        {
          "uid": "vcroles-not-ready",
          "title": "Bot is not ready",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "mimir",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "mimir"
                },
                "expr": "min(vcroles_bot_ready{job=\"vcroles\"})",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A < 1"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "2m",
          "isPaused": true,
          "annotations": {
            "summary": "Bot is not ready",
            "description": "Paused until the production SDK and notification routing are reviewed."
          },
          "labels": {
            "service": "vcroles",
            "severity": "warning"
          }
        },
        {
