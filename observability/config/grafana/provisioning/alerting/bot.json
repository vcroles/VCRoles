            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "mimir",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "mimir"
                },
                "expr": "sum(rate({__name__=~\"otel_sdk_processor_(span|log)_processed\",job=\"vcroles\",error_type!=\"\"}[5m]))",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A > 0"
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "5m",
          "isPaused": true,
          "annotations": {
            "summary": "SDK is dropping telemetry",
